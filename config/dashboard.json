{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__elements": {},
  "__requires": [
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "title": "Harness Engine Execution Metrics",
  "panels": [
    {
      "title": "Total Runs per Hour",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(harness_agent_run_count[1h])) * 3600",
          "legendFormat": "Runs"
        }
      ]
    },
    {
      "title": "Policy Decisions by Outcome",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (decision) (rate(resolve_policy_decision_count[5m]))",
          "legendFormat": "{{decision}}"
        }
      ]
    }
  ]
}
