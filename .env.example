# --- required ---------------------------------------------------------------
VAULT_DEV_ROOT_TOKEN_ID=replace-with-a-local-dev-token
# Bearer token for the control-plane API (generate: openssl rand -hex 32). There is no default.
HARNESS_API_TOKEN=replace-with-a-long-random-token

# --- LLM provider (the harness never sees this key; it is read from Vault) ------
VAULT_PROVIDER_KEY=groq
PROVIDER_API_KEY=replace-with-your-provider-api-key
HARNESS_MODEL=groq/openai/gpt-oss-120b
# HARNESS_FALLBACK_MODELS=groq/compound

# --- approvals -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=replace-with-a-new-telegram-bot-token
TELEGRAM_APPROVAL_CHAT_ID=replace-with-your-private-chat-id
# Comma-separated approver ids allowed to approve (e.g. telegram:123456789,api:*). Empty = any member of the chat.
HARNESS_APPROVERS=

# --- optional ------------------------------------------------------------------
# HARNESS_GITOPS_REPOS=/srv/gitops        # repositories the agent may open PRs against
# HARNESS_STAGING_APPS=stg-*              # ArgoCD apps treated as staging (everything else is R3)
# HARNESS_SANDBOX=bwrap                   # none | bwrap | docker
# HARNESS_WEBHOOK_ENDPOINTS=https://ci.example/hook
# HARNESS_WEBHOOK_SECRET=replace-with-hmac-secret
# HARNESS_RECEIPT_KEY=replace-with-hmac-key  # makes the receipt hash chain unforgeable without the key
